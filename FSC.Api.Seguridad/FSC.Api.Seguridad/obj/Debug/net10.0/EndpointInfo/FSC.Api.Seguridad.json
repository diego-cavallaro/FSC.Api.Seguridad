{
  "openapi": "3.0.4",
  "info": {
    "title": "FSC-Authentication-API",
    "version": "v1"
  },
  "paths": {
    "/FSC/Api/Autenticacion/Validar": {
      "post": {
        "tags": [
          "Autenticacion"
        ],
        "parameters": [
          {
            "name": "loginName",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "password",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/FSC/Api/Derechos/GetDerechos": {
      "get": {
        "tags": [
          "Derechos"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
